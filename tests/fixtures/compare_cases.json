        },
        {
          "type": "library",
          "name": "@Scope/name",
          "version": "1",
          "purl": "pkg:npm/%40Scope/Name@1"
        },
        {
          "type": "library",
          "name": "bad",
          "purl": "not-a-purl",
          "version": "1"
        }
      ]
    },
    "b": {
      "bomFormat": "CycloneDX",
      "specVersion": "1.6",
      "components": [
        {
          "type": "library",
          "name": "my-pkg",
          "version": "1+CPU",
          "purl": "pkg:pypi/my-pkg@1+CPU"
        },
        {
          "type": "library",
          "name": "@scope/name",
          "version": "1",
          "purl": "pkg:npm/@scope/name@1"
        }
      ]
    },
    "expected": {
      "exact.common": 2,
      "a.excluded.invalid-purl": 1,
      "a.total_components": 2
    }
  },
