[
  {
    "name": "versions-overlap-without-identity-missing",
    "a": {
      "bomFormat": "CycloneDX",
      "specVersion": "1.6",
      "components": [
        {
          "type": "library",
          "name": "demo",
          "purl": "pkg:npm/demo@1",
          "version": "1"
        },
        {
          "type": "library",
          "name": "demo",
          "purl": "pkg:npm/demo@2",
          "version": "2"
        },
        {
          "type": "library",
          "name": "only-a",
          "purl": "pkg:npm/only-a@1",
          "version": "1"
        }
      ]
    },
    "b": {
      "bomFormat": "CycloneDX",
      "specVersion": "1.6",
      "components": [
        {
          "type": "library",
          "name": "demo",
          "purl": "pkg:npm/demo@2",
          "version": "2"
        },
        {
          "type": "library",
          "name": "demo",
          "purl": "pkg:npm/demo@3",
          "version": "3"
        },
        {
          "type": "library",
          "name": "only-b",
          "purl": "pkg:npm/only-b@1",
          "version": "1"
        }
      ]
    },
    "expected": {
      "exact.common": 1,
      "identity.common": 1,
      "version_differences.length": 1,
      "only_identities_a.length": 1,
      "only_identities_b.length": 1,
      "only_keys_a.length": 2
    }
  },
