        {
          "ref": "absent",
          "dependsOn": []
        }
      ]
    },
    "b": {
      "bomFormat": "CycloneDX",
      "specVersion": "1.6",
      "components": [
        {
          "type": "library",
          "name": "one",
          "purl": "pkg:npm/one@1",
          "version": "1",
          "bom-ref": "x"
        },
        {
          "type": "library",
          "name": "two",
          "purl": "pkg:npm/two@1",
          "version": "1",
          "bom-ref": "y"
        }
      ],
      "dependencies": [
        {
          "ref": "x",
          "dependsOn": [
            "y"
          ]
        }
      ]
    },
    "expected": {
      "graph.common": 1,
      "a.edges.length": 1,
      "a.dangling_refs.length": 2,
      "a.duplicate_refs.length": 1
    }
  },
