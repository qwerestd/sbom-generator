        {
          "type": "library",
          "name": "three",
          "purl": "pkg:npm/three@1",
          "version": "1",
          "bom-ref": "duplicate"
        },
        {
          "type": "library",
          "name": "four",
          "purl": "pkg:npm/four@1",
          "version": "1",
          "bom-ref": "duplicate"
        }
      ],
      "dependencies": [
        {
          "ref": "a",
          "dependsOn": [
            "b",
            "b",
            "missing",
            "duplicate"
          ]
