  {
    "name": "references-dedup-dangling-and-duplicate-ids",
    "a": {
      "bomFormat": "CycloneDX",
      "specVersion": "1.6",
      "components": [
        {
          "type": "library",
          "name": "one",
          "purl": "pkg:npm/one@1",
          "version": "1",
          "bom-ref": "a"
        },
        {
          "type": "library",
          "name": "two",
