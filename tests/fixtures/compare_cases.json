      "specVersion": "1.6",
      "components": [
        {
          "type": "library",
          "name": "demo",
          "purl": "pkg:npm/demo@1",
          "version": "1",
          "bom-ref": "b1",
          "properties": [
            {
              "name": "syft:location:0:path",
              "value": "src/y/package.json"
            }
          ]
        }
      ]
